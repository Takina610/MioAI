# ============================================================
# MioAI 后端配置模板
# 复制为 application.yml（该文件已被 .gitignore 排除，禁止提交真实配置）
# 所有敏感项均可用同名大写环境变量覆盖，Docker 部署时通过 environment 注入
# ============================================================

server:
  port: 8081

spring:
  application:
    name: mio-ai

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # HOST/PORT/密码建议用环境变量注入：MYSQL_HOST、MYSQL_PASSWORD 等
    url: jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/mio_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${MYSQL_USERNAME:root}
    password: ${MYSQL_PASSWORD:changeme}

  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      database: 0
      # spring-ai 的 RedisVectorStore 自动配置要求 JedisConnectionFactory（类路径同时有 lettuce/jedis 时 Boot 默认用 lettuce）
      client-type: jedis

  ai:
    # 阿里云 DashScope 走 OpenAI 兼容模式（Spring AI 2.0 官方 openai starter）。
    # 注意：2.0 底层为 openai-java SDK，不再自动补 /v1，base-url 必须以 /v1 结尾
    openai:
      api-key: ${DASHSCOPE_API_KEY:your-dashscope-api-key}
      base-url: ${DASHSCOPE_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
      chat:
        model: ${DASHSCOPE_CHAT_MODEL:qwen-plus}
      embedding:
        model: ${DASHSCOPE_EMBEDDING_MODEL:text-embedding-v3}

    # Redis 向量库（需要 RedisStack，含 RediSearch 模块）
    vectorstore:
      redis:
        initialize-schema: true
        index-name: mio-ai-index
        prefix: "mio-ai:"

    # 聊天记忆入库（启动时自动建表；取值为 DatabaseInitializationMode：always/embedded/never）
    chat:
      memory:
        repository:
          jdbc:
            initialize-schema: always

  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 100MB

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      logic-delete-field: isDeleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# ------------------------------------------------------------
# MioAI 自有配置
# ------------------------------------------------------------
mio:
  ai:
    # RAG 检索配置
    rag:
      # 重排总开关（绑定级开关见 agent_knowledge.retrieval_config）
      rerank-enabled: false
      rerank-model: gte-rerank
      rerank-top-n: 5
      # DashScope 原生重排 API（OpenAI 兼容模式不提供 rerank，需直连原生端点）
      rerank-api-url: ${DASHSCOPE_RERANK_URL:https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank}
      rerank-api-key: ${DASHSCOPE_API_KEY:your-dashscope-api-key}
      # 分块大小（token），消融实验可取 400/800/1200
      chunk-size: 800
    # 长会话摘要记忆
    memory:
      summary-enabled: true
      summary-threshold: 80
      keep-recent-messages: 20
    # 终端工具白名单（逗号分隔，留空使用安全默认值）
    tools:
      terminal:
        allowed-commands: ""

# ------------------------------------------------------------
# 联网搜索 / 图片检索工具（MioManus 智能体使用，密钥由环境变量注入）
# ------------------------------------------------------------
web:
  search:
    url: ${WEB_SEARCH_URL:https://www.searchapi.io/api/v1/search}
    api-key: ${WEB_SEARCH_API_KEY:}
pexels:
  search:
    url: ${PEXELS_SEARCH_URL:https://api.pexels.com/v1/search}
    api-key: ${PEXELS_API_KEY:}

# RAG 示例数据初始化开关（true=跳过，不自动灌入示例文档）
data:
  is-load: ${DATA_IS_LOAD:true}

# ------------------------------------------------------------
# Cloudflare R2 对象存储（文件/头像/知识库文件）
# ------------------------------------------------------------
r2:
  endpoint: ${R2_ENDPOINT:https://your-account.r2.cloudflarestorage.com}
  access-key-id: ${R2_ACCESS_KEY_ID:your-access-key-id}
  secret-access-key: ${R2_SECRET_ACCESS_KEY:your-secret-access-key}
  bucket-name: ${R2_BUCKET:mio-ai}
  cdn-domain: ${R2_CDN_DOMAIN:https://your-cdn-domain.com}

logging:
  level:
    root: info
    com.mio.ai: debug
