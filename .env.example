# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，禁止提交）
# MySQL
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_USERNAME=mioai
MYSQL_PASSWORD=changeme

# PostgreSQL 向量库（pgvector）
PG_USERNAME=postgres
PG_PASSWORD=mioai
PG_DATABASE=mio_ai_vec

# Embedding 网关（OpenAI 兼容 /v1/embeddings，模型 mistral-embed 输出 1024 维）
EMBED_APIKEY=your-embed-api-key
# EMBED_BASE_URL=https://api.42x.shop/v1
# EMBED_MODEL=mistral-embed

# 仅重排（rerank）依赖 DashScope 原生端点，默认关闭，可留空
DASHSCOPE_API_KEY=

# GitHub PAT（知识库 GitHub 导入提升 API 限额用，可选，留空走匿名限额）
GITHUB_TOKEN=

# 联网搜索 / 图片检索（MioManus 智能体工具，可选）
WEB_SEARCH_API_KEY=your-searchapi-key
PEXELS_API_KEY=your-pexels-key

# Cloudflare R2
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=mio-ai
R2_CDN_DOMAIN=https://your-cdn-domain.com
